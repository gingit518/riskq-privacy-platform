# Postgres connection string (Vercel Postgres, Neon, or Supabase all work with the `postgres` driver).
# Not provisioned yet — see README "Setup required before this deploys".
DATABASE_URL=postgres://user:password@host:5432/dbname

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-32-byte-secret

# Vercel Blob read/write token — auto-injected once you create a Blob store
# in Vercel and connect it to this project (Storage tab -> Create Database ->
# Blob), same pattern as DATABASE_URL above. Required for evidence uploads on
# /obligations, /controls, and /dsar (src/lib/evidence.ts).
BLOB_READ_WRITE_TOKEN=replace-with-a-vercel-blob-token

# Resend API key (resend.com) — required for the "Send response now" button
# on a DSAR request (src/lib/email.ts). Nothing else in the app sends email.
RESEND_API_KEY=replace-with-a-resend-api-key

# Sending address for DSAR response emails — must be on a domain verified in
# Resend, or leave unset to use Resend's sandbox onboarding@resend.dev while
# testing (real inboxes only, not deliverable to arbitrary addresses).
EMAIL_FROM=privacy@your-verified-domain.com

# Absolute base URL of this deployment, used to build the DSAR download link
# that gets emailed to requesters (a relative path doesn't work outside the
# app). Falls back to Vercel's auto-injected VERCEL_URL if unset, but set
# this explicitly to your production domain to be sure.
APP_BASE_URL=https://your-deployment.vercel.app

# Phase 7 (PRD §5.10) — DSAR connector fulfillment. See README "Phase 7" and
# src/lib/connectors/*.ts for what's real vs. stubbed.

# Encrypts connector OAuth refresh tokens at rest (connector_connections
# table) — required as soon as any real connector is connected, not needed
# for mock mode. Generate with: openssl rand -base64 32
CONNECTOR_ENCRYPTION_KEY=replace-with-a-random-32-byte-secret

# Set to "true" to use the fake in-memory mock connectors instead of the
# (currently unimplemented) real Salesforce/M365/Google Drive connectors —
# lets the full search/approve/execute pipeline be reviewed end to end
# before any real OAuth app is registered. Do NOT set this in a real
# customer-facing deployment.
CONNECTOR_MOCK_MODE=false

# Real connector credentials — none of these are used yet (search()/
# exportRecords()/deleteRecords() all still throw "not implemented" even
# once these are set); only isConfigured() checks them today, to drive the
# /connectors page's status display. See each connector file for the exact
# provider-console setup steps.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
